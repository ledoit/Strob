# Local PartyKit dev server (partykit dev)
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# After `pnpm party:deploy`, set to your PartyKit host (no https://), e.g.:
NEXT_PUBLIC_PARTYKIT_HOST=strob-party.ledoit.partykit.dev

# Spotify (v2) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional; defaults to {NEXT_PUBLIC_APP_URL}/api/spotify/callback
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BPM lookup (v2 fallback + v3 search) — free key at https://getsongbpm.com/api
GETSONGBPM_API_KEY=
